{
  "name": "inband",
  "version": "1.0.0",
  "description": "MCP daemon for async messaging between coding agents (Claude Code, Codex, OpenCode)",
  "license": "MIT",
  "keywords": [
    "mcp",
    "agent",
    "claude-code",
    "codex",
    "opencode",
    "daemon",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruipedro-pinheiro/InBand.git"
  },
  "homepage": "https://github.com/ruipedro-pinheiro/InBand#readme",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit --skipLibCheck --types bun --allowImportingTsExtensions --moduleResolution bundler --module preserve --target es2022 src/*.ts scripts/*.ts tests/*.ts",
    "prepublish:security": "bash scripts/prepublish-check.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@hono/node-server": "2.1.1",
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.2",
    "qs": "6.16.0"
  }
}
